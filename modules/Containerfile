# syntax=docker/dockerfile:1.6

FROM ghcr.io/coder/coder@sha256:215e6d4c1260e213a283dbac9b669b7bd79f5dd25974d72ae18b45c565f062bb AS builder

USER root

ARG TARGETARCH

COPY --chmod=0444 modules/modules.lock /tmp/modules.lock

RUN set -eu; \
  if [ "${TARGETARCH}" != "amd64" ]; then \
    printf 'Unsupported module architecture: %s (only amd64 is supported)\n' "${TARGETARCH}" >&2; \
    exit 1; \
  fi; \
  mkdir -p /out; \
  module_count=0; \
  while IFS='|' read -r name version expected_sha256 source_url; do \
    case "${name}" in ''|'#'*) continue ;; esac; \
    module_count=$((module_count + 1)); \
    source_archive="/tmp/${name}-${version}.tar.gz"; \
    module_dir="/out/${name}"; \
    printf 'Fetching %s@%s\n' "${name}" "${version}"; \
    curl --compressed --fail --location --show-error --silent \
      "${source_url}" --output "${source_archive}"; \
    printf '%s  %s\n' "${expected_sha256}" "${source_archive}" \
      | sha256sum -c -s; \
    mkdir -p "${module_dir}"; \
    tar -xzf "${source_archive}" -C "${module_dir}"; \
    rm -f "${source_archive}"; \
    test "$(grep -Fxc '      source  = "coder/coder"' "${module_dir}/main.tf")" -eq 1; \
    sed -i \
      's#source  = "coder/coder"#source  = "registry.terraform.io/coder/coder"#' \
      "${module_dir}/main.tf"; \
    test "$(grep -Fxc '      source  = "registry.terraform.io/coder/coder"' "${module_dir}/main.tf")" -eq 1; \
  done < /tmp/modules.lock; \
  test "${module_count}" -gt 0; \
  test "$(find /out -mindepth 1 -maxdepth 1 -type d | wc -l)" -eq "${module_count}"; \
  find /out -type d -exec chmod 0755 {} +; \
  find /out -type f -exec chmod 0644 {} +

FROM scratch

LABEL org.opencontainers.image.title="Coder OpenTofu modules" \
  org.opencontainers.image.description="Read-only OpenTofu module payload for offline Coder provisioning" \
  org.opencontainers.image.source="https://github.com/fabian1heinrich/coder-workspaces" \
  org.opencontainers.image.version="0.1.0" \
  io.coder.module.code-server.version="1.5.2" \
  io.coder.module.coder-login.version="1.1.1" \
  io.coder.module.dotfiles.version="1.4.2" \
  io.coder.module.git-clone.version="2.0.3" \
  io.coder.module.git-config.version="1.0.34" \
  io.coder.image-volume.mount-path="/opt/coder-modules"

COPY --from=builder /out/ /
