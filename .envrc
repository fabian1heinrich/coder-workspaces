# shellcheck shell=bash
dotenv_if_exists .env

# Keep local paths stable when entering through a symlink.
project_root="$(pwd -P)"

export CACHE_DIR="${CACHE_DIR:-$project_root/.cache}"
case "$CACHE_DIR" in
/*) ;;
*) export CACHE_DIR="$project_root/$CACHE_DIR" ;;
esac

export XDG_CACHE_HOME="$CACHE_DIR/xdg"
export BUILD_DIR="$CACHE_DIR/build"
export TMPDIR="$CACHE_DIR/tmp"
export TMP="$TMPDIR"
export TEMP="$TMPDIR"

export ZARF_CACHE="$CACHE_DIR/zarf/cache"
export ZARF_TMP_DIR="$CACHE_DIR/zarf/tmp"
export ZARF_CONFIG="${ZARF_CONFIG:-$project_root/dev/zarf-config.yaml}"

export KUBECONFIG="${KUBECONFIG:-$project_root/kubeconfig}"

mkdir -p -- "$XDG_CACHE_HOME" "$BUILD_DIR" "$TMPDIR" "$ZARF_CACHE" "$ZARF_TMP_DIR"

unset project_root
