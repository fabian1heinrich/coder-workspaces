# Publish using zarf-config.yaml and the manually supplied, command-scoped token.
publish:
    #!/usr/bin/env bash
    set -euo pipefail
    : "${ZARF_VAR_CODER_TOKEN:?Supply your manually created Coder API token in the environment}"
    shopt -s nullglob
    packages=(./zarf-package-coder-workspaces-publish-amd64-*.tar.zst)
    test "${#packages[@]}" -eq 1 || { echo "Expected one publication package in this release directory." >&2; exit 1; }
    zarf package deploy "${packages[0]}" --connected --confirm \
      --set-variables "CODER_TOKEN=$ZARF_VAR_CODER_TOKEN"
