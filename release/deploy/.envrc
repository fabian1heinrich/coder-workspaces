# shellcheck shell=bash
dotenv_if_exists .env

airgapped_root="$(pwd -P)"
default_data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/coder-workspaces"
case "${CODER_WORKSPACES_DATA_DIR:-$default_data_dir}" in
  /*) export CODER_WORKSPACES_DATA_DIR="${CODER_WORKSPACES_DATA_DIR:-$default_data_dir}" ;;
  *) export CODER_WORKSPACES_DATA_DIR="$airgapped_root/${CODER_WORKSPACES_DATA_DIR:-$default_data_dir}" ;;
esac

export ZARF_CACHE="$CODER_WORKSPACES_DATA_DIR/zarf/cache"
export ZARF_TMP_DIR="$CODER_WORKSPACES_DATA_DIR/zarf/tmp"
mkdir -p -- "$ZARF_CACHE" "$ZARF_TMP_DIR"

case "${KUBECONFIG:-kubeconfig}" in
  /*) export KUBECONFIG ;;
  *) export KUBECONFIG="$airgapped_root/${KUBECONFIG:-kubeconfig}" ;;
esac

unset airgapped_root default_data_dir
