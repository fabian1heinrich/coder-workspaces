# shellcheck shell=bash
dotenv_if_exists .env

airgapped_root="$(pwd -P)"
default_data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/coder-workspaces"
case "${CODER_WORKSPACES_DATA_DIR:-$default_data_dir}" in
  /*) export CODER_WORKSPACES_DATA_DIR="${CODER_WORKSPACES_DATA_DIR:-$default_data_dir}" ;;
  *) export CODER_WORKSPACES_DATA_DIR="$airgapped_root/${CODER_WORKSPACES_DATA_DIR:-$default_data_dir}" ;;
esac

export ZARF_ZARF_CACHE="$CODER_WORKSPACES_DATA_DIR/zarf/cache"
export ZARF_TMP_DIR="$CODER_WORKSPACES_DATA_DIR/zarf/tmp"
mkdir -p -- "$ZARF_TMP_DIR"

case "${KUBECONFIG:-kubeconfig}" in
  /*) export KUBECONFIG ;;
  *) export KUBECONFIG="$airgapped_root/${KUBECONFIG:-kubeconfig}" ;;
esac

export REGISTRY_URL="${REGISTRY_URL:?Set REGISTRY_URL in .env}"
export REGISTRY_PUSH_USERNAME="${REGISTRY_PUSH_USERNAME:?Set REGISTRY_PUSH_USERNAME in .env}"
export REGISTRY_CA_FILE="${REGISTRY_CA_FILE:?Set REGISTRY_CA_FILE in .env}"
export REGISTRY_WRITER_SECRET_NAMESPACE="${REGISTRY_WRITER_SECRET_NAMESPACE:?Set REGISTRY_WRITER_SECRET_NAMESPACE in .env}"
export REGISTRY_WRITER_SECRET_NAME="${REGISTRY_WRITER_SECRET_NAME:?Set REGISTRY_WRITER_SECRET_NAME in .env}"
export REGISTRY_WRITER_SECRET_KEY="${REGISTRY_WRITER_SECRET_KEY:?Set REGISTRY_WRITER_SECRET_KEY in .env}"
export WORKLOAD_NAMESPACE="${WORKLOAD_NAMESPACE:?Set WORKLOAD_NAMESPACE in .env}"
export PUBLISHER_JOB_NAME="${PUBLISHER_JOB_NAME:?Set PUBLISHER_JOB_NAME in .env}"

unset airgapped_root default_data_dir

export GIT_PAGER=cat
export PAGER=cat
export SYSTEMD_PAGER=cat
export ZARF_NO_COLOR=true
export ZARF_NO_PROGRESS=true
