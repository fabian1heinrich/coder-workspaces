# Host settings only. Publication inputs belong in zarf-config.yaml.
# Never store the Coder API token here.
KUBECONFIG=kubeconfig
REGISTRY_PUSH_USERNAME=zot-writer
REGISTRY_CA_FILE=../herd-zero-bootstrap/platform-root-ca.pem
REGISTRY_WRITER_SECRET_NAMESPACE=flux-system
REGISTRY_WRITER_SECRET_NAME=zot-writer
REGISTRY_WRITER_SECRET_KEY=password
# CODER_WORKSPACES_DATA_DIR=/media/data/coder-workspaces
