# Air-gapped workspace release environment. Copy to `.env` with mode 0600.

KUBECONFIG=kubeconfig

# Values are supplied by the consuming platform; no production endpoint or
# credential name is embedded in the release.
REGISTRY_URL=registry.example.invalid
REGISTRY_PUSH_USERNAME=registry-writer
REGISTRY_CA_FILE=platform-root-ca.pem
REGISTRY_WRITER_SECRET_NAMESPACE=flux-system
REGISTRY_WRITER_SECRET_NAME=registry-writer
REGISTRY_WRITER_SECRET_KEY=password
WORKLOAD_NAMESPACE=coder-template-publisher
PUBLISHER_JOB_NAME=

# Optional persistent location for Zarf cache and temporary files.
# CODER_WORKSPACES_DATA_DIR=/media/data/coder-workspaces
