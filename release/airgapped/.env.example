# Air-gapped workspace release environment. Copy to `.env` with mode 0600.

KUBECONFIG=kubeconfig

# Herd Zero registry used by both image mirroring and template publication.
ZARF_VAR_REGISTRY=registry.herd-zero.internal

# Registry mirroring settings. The CA is also the default Coder client CA.
REGISTRY_PUSH_USERNAME=zot-writer
REGISTRY_CA_FILE=../herd-zero-bootstrap/platform-root-ca.pem
REGISTRY_WRITER_SECRET_NAMESPACE=flux-system
REGISTRY_WRITER_SECRET_NAME=zot-writer
REGISTRY_WRITER_SECRET_KEY=password

# Publication inputs consumed by `just publish`. The recipe maps them to Zarf
# deployment variables; the Zarf CLI does not consume arbitrary ZARF_VAR_*
# process variables directly. `just publish` securely prompts for the manually
# created Coder API token; never store it in this file.
ZARF_VAR_HOME_STORAGE_CLASS=ceph-block
ZARF_VAR_PLATFORM_CA_CONFIG_MAP_NAME=coder-platform-root-ca
ZARF_VAR_GIT_BASE_URL=https://forgejo.herd-zero.internal

# Empty repository values publish uncloned sandbox and Kubernetes environments.
# Fill them with existing Forgejo owner/repository paths when those defaults
# have been provisioned.
ZARF_VAR_SANDBOX_REPOSITORY=
ZARF_VAR_K8S_DEV_REPOSITORY=
ZARF_VAR_DEFAULT_DOTFILES_REPOSITORY=

# Project images are carried by the production image package. Repository
# defaults remain optional until matching Forgejo repositories exist.
ZARF_VAR_DEJA_DOC_IMAGE=registry.herd-zero.internal/fabian1heinrich/coder-workspaces/deja-doc:sha-36f435f0b3de849e4704f6eed45236f8645e6166@sha256:6cad2e90ed0fc00a4287e53687b3e5fc6551e6aa35f5bb99f76ea9040d7931b2
ZARF_VAR_DEJA_DOC_REPOSITORY=
ZARF_VAR_DUPE_TROOPER_IMAGE=registry.herd-zero.internal/fabian1heinrich/coder-workspaces/dupe-trooper:sha-36f435f0b3de849e4704f6eed45236f8645e6166@sha256:cf9abbef2aad9cf75579c22cb821f01b322ec296624eedfa6fd47b8e5306ecd2
ZARF_VAR_DUPE_TROOPER_REPOSITORY=

# Optional persistent location for Zarf cache and temporary files.
# CODER_WORKSPACES_DATA_DIR=/media/data/coder-workspaces
