# Air-gapped workspace release environment. Copy to `.env` with mode 0600.

KUBECONFIG=kubeconfig

# Used by both image mirroring and template publication.
ZARF_VAR_REGISTRY=registry.example.invalid

# Needed only when mirroring images.
REGISTRY_PUSH_USERNAME=registry-writer
REGISTRY_CA_FILE=platform-root-ca.pem
REGISTRY_WRITER_SECRET_NAMESPACE=flux-system
REGISTRY_WRITER_SECRET_NAME=registry-writer
REGISTRY_WRITER_SECRET_KEY=password

# Needed only by `just create-publisher-token`. The password is prompted for
# and is not stored here.
CODER_URL=https://coder.example.invalid
CODER_EMAIL=template-publisher@example.invalid

# Publication values. The Coder token is deliberately absent: `just
# create-publisher-token` creates it immediately before publishing and passes it
# as ZARF_VAR_CODER_TOKEN for that one command.
# ZARF_VAR_PROJECT_IMAGES=
# ZARF_VAR_HOME_STORAGE_CLASS=
# ZARF_VAR_GIT_BASE_URL=
# ZARF_VAR_DEFAULT_REPOSITORY=
# ZARF_VAR_K8S_DEFAULT_REPOSITORY=
# ZARF_VAR_DEFAULT_DOTFILES_REPOSITORY=

# Optional persistent location for Zarf cache and temporary files.
# CODER_WORKSPACES_DATA_DIR=/media/data/coder-workspaces
