# Create a one-hour token for template publication.
create-publisher-token:
    #!/usr/bin/env bash
    set -euo pipefail
    printf 'Coder password for %s: ' "$CODER_EMAIL" >&2
    IFS= read -rs password
    printf '\n' >&2
    session_token="$(
      jq -nc --arg email "$CODER_EMAIL" --arg password "$password" \
        '{email: $email, password: $password}' |
        curl -fsS "$CODER_URL/api/v2/users/login" \
          -H 'Content-Type: application/json' --data-binary @- |
        jq -r .session_token
    )"
    CODER_SESSION_TOKEN="$session_token" coder tokens create \
      --name "template-publisher-$(date -u +%Y%m%d%H%M%S)" --lifetime 1h
